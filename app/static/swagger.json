{
  "openapi": "3.0.0",
  "info": {
    "title": "Revocation API",
    "version": "0.1.0",
    "contact": {}
  },
  "servers": [
    {
      "url": "https://dev.issuer.eudiw.dev"
    }
  ],
  "paths": {
    "/token_status_list/get": {
      "get": {
        "summary": "Retrieve Token Status",
        "operationId": "getTokenStatusList",
        "description": "Retrieves the status of a token from the revocation list. WARNING: This endpoint is for debug and testing purposes only. Give 'idx', 'id' or both, with the status list or the identifier list URI (the URI only selects the list); both must name the same token (else 400). An unknown 'id' is 404 'Unknown identifier'.",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "string"
            },
            "description": "Identifier list id of the token (the 'id' /take returned): an opaque string of at most 64 characters, not the index. Tokens issued before the ids were random have the index as id."
          },
          {
            "in": "query",
            "name": "idx",
            "schema": {
              "type": "integer"
            },
            "description": "Index of the token in the status list (the 'idx' /take returned)."
          },
          {
            "in": "query",
            "name": "uri",
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "URL-encoded URI parameter.",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing token status information.",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/token_status_list/set": {
      "post": {
        "summary": "Set Token Status",
        "operationId": "setTokenStatus",
        "description": "Revokes a token (status 1): sets its bit in the status list and adds its id to the identifier list. Give 'idx', 'id' or both, with the status list or the identifier list URI (the URI only selects the list); both must name the same token (else 400). An unknown 'id' is 404 'Unknown identifier'. A token never handed out by /take is 404 'Unknown entry'.",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key for authentication."
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "anyOf": [
                  { "required": ["id"] },
                  { "required": ["idx"] }
                ],
                "properties": {
                  "id": { "type": "string", "description": "Identifier list id of the token (the 'id' /take returned): an opaque string of at most 64 characters, not the index. Tokens issued before the ids were random have the index as id." },
                  "idx": { "type": "integer", "description": "Index of the token in the status list (the 'idx' /take returned)." },
                  "status": { "type": "integer", "description": "The new status value for the token." },
                  "uri": { "type": "string", "description": "URI associated with the token status." }
                },
                "required": ["status", "uri"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response indicating the token status has been updated.",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/token_status_list/take": {
      "post": {
        "summary": "Generate status structure",
        "operationId": "takeTokenStatus",
        "description": "Generates a new status structure to be included in a credential as well as a new entry in the attestation status list.",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key for authentication."
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "country": { "type": "string", "description": "Country code associated with the document." },
                  "doctype": { "type": "string", "description": "Document type (e.g., eu.europa.ec.eudi.pid.1, org.iso.18013.5.1.mDL)." },
                  "expiry_date": { "type": "string", "description": "Expiration date of the document in YYYY-MM-DD format." }
                },
                "required": ["country", "doctype", "expiry_date"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response containing revocation status information.",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/token_status_list/take/batch": {
      "post": {
        "summary": "Generate several status structures",
        "operationId": "takeTokenStatusBatch",
        "description": "As /token_status_list/take, for 'count' credentials of one country, doctype and expiry date. Full lists are followed by new ones, so the items may point to several lists. All indices are taken or none.",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key for authentication."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "country": { "type": "string", "description": "Country code associated with the documents." },
                  "doctype": { "type": "string", "description": "Document type (e.g., eu.europa.ec.eudi.pid.1, org.iso.18013.5.1.mDL)." },
                  "expiry_date": { "type": "string", "description": "Latest expiration date of the documents in YYYY-MM-DD format." },
                  "count": { "type": "integer", "minimum": 1, "description": "Number of indices to take, at most batch_max_size (default 1000)." }
                },
                "required": ["country", "doctype", "expiry_date", "count"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One status structure per index, in the order they were taken; each is what /token_status_list/take returns.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "status_list": {
                            "type": "object",
                            "properties": { "uri": { "type": "string" }, "idx": { "type": "integer" } }
                          },
                          "identifier_list": {
                            "type": "object",
                            "properties": { "uri": { "type": "string" }, "id": { "type": "string", "description": "Random identifier list id (32 hex characters), unrelated to 'idx'." } }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid field, count below 1 or a body that is not a JSON object.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "Wrong or missing API key.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "count over batch_max_size, or a body over 1 MiB.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/token_status_list/set/batch": {
      "post": {
        "summary": "Revoke several tokens",
        "operationId": "setTokenStatusBatch",
        "description": "Revokes (status 1) every entry of 'refs', which may belong to several lists, countries and doctypes. All entries are revoked or none: the error names the first ref that failed (e.g. 'refs[3]: Unknown list'). An entry named twice, through either URI, is revoked once; revoked entries stay revoked.",
        "parameters": [
          {
            "in": "header",
            "name": "X-API-Key",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "API key for authentication."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Entries to revoke, at most batch_max_size (default 1000).",
                    "items": {
                      "type": "object",
                      "properties": {
                        "uri": { "type": "string", "description": "Status list or identifier list URI returned by /take." },
                        "idx": { "type": "integer", "description": "Index of the entry in the status list." },
                        "id": { "type": "string", "description": "Identifier list id of the entry, as /take returned it. With 'idx' too, both must name the same entry." }
                      },
                      "required": ["uri"]
                    }
                  }
                },
                "required": ["refs"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every entry is revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "revoked": { "type": "integer", "description": "Number of distinct entries." } }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ref, empty refs or a body that is not a JSON object.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "Wrong or missing API key.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "A ref names an unknown list, an unknown 'id' or an index never taken.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "More refs than batch_max_size, or a body over 1 MiB.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "A list cannot be read.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      }
    }
  }
}
